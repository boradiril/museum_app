# MUSE — environment variables (§5.1)
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# --- Supabase ---
# Public (safe in the browser): Project URL + anon key.
# Find in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Added in later phases (kept here for reference) ---
# ANTHROPIC_API_KEY=          # Phase 4 — LLM curation (server-only)
# STRIPE_SECRET_KEY=          # Phase 5 — payment (server-only)
# STRIPE_WEBHOOK_SECRET=      # Phase 5 — webhook signature verification
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # Phase 5 — client
